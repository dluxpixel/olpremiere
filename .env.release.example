# Copy this file to `.env.release` (which is gitignored) and paste a GitHub token.
# Then shipping an update is one command, no token needed each time:
#   npm run ship          (bump patch + build + publish -> everyone auto-updates)
#   npm run ship:minor    (bump minor)
#
# Token: github.com/settings/tokens, fine-grained, repo dluxpixel/olpremiere,
# Contents: Read and write. Long expiry is fine since it lives only on this machine.
# It must belong to the account that OWNS the repo in electron-builder.yml.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
