.tmp-dev.log

# Electron desktop build
out/
release/
# The bench copy of the app. Built on demand by scripts/lab.mjs, never shipped.
vendor/ffmpeg/

# Release token (never committed). Put GH_TOKEN=... here to auto-publish updates.
# The glob, not two exact names: .env.local / .env.production / a hand-made
# .env.release.bak are all live secrets, and naming them one at a time means the
# first one nobody thought of gets committed. `.env.release.example` is the only
# one that SHOULD be tracked, and it is already tracked, so the glob cannot
# retroactively drop it.
.env*
!.env.release.example
ship-*.log
