node_modules/
dist/
playwright-report/
test-results/
_verify/
*.local
.DS_Store
e2e/.fixtures/

.vercel

# Dev server scratch log. Committed by accident once in v0.1.29.
.tmp-dev.log

# Electron desktop build
out/
release/
# The bench copy of the app. Built on demand by scripts/lab.mjs, never shipped.
vendor/ffmpeg/

# Release token (never committed). Put GH_TOKEN=... here to auto-publish updates.
# The glob, not two exact names: .env.local / .env.production / a hand-made
# .env.release.bak are all live secrets, and naming them one at a time means the
# first one nobody thought of gets committed. `.env.release.example` is the only
# one that SHOULD be tracked, and it is already tracked, so the glob cannot
# retroactively drop it.
.env*
!.env.release.example
ship-*.log

# Scratch launcher for the detached ship. Never part of the app.
ship-now.cmd

# His own project files (*.olstudio) and his media folder (OLP-MEDIA) sit in this
# folder and are never part of the app. A release takes every new file that is not
# ignored, so both are named here.
# 2026-10-25: three project files and the media folder, about 4.3 GB, went into
# a release commit because nothing ignored them.
*.olstudio
/OLP-MEDIA/
