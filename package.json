{
  "name": "ol-premiere",
  "private": true,
  "version": "0.1.71",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "ci": "tsc --noEmit && eslint . && vitest run && vite build",
    "dev:electron": "electron-vite dev",
    "build:electron": "tsc -p tsconfig.electron.json && electron-vite build",
    "preview:electron": "electron-vite preview",
    "dist:dir": "npm run build:electron && electron-builder --dir",
    "dist": "npm run build:electron && electron-builder --win",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.mjs",
    "patch": "node scripts/patch.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "npm version patch --no-git-tag-version && node scripts/release.mjs",
    "ship": "npm version patch --no-git-tag-version && node scripts/release.mjs",
    "ship:minor": "npm version minor --no-git-tag-version && node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "electron-updater": "^6.8.9",
    "idb": "^8.0.1",
    "lucide-react": "^0.469.0",
    "mediabunny": "^1.50.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yjs": "^13.6.31",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/blob": "^2.6.1",
    "@vercel/node": "^5.8.23",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^3.0.4"
  },
  "productName": "OL Premiere"
}
