# Web deploy: exclude desktop-only binaries, build artifacts, and test output.
# ffmpeg.exe (138 MB) is bundled for the Electron native exporter. The web app never uses it.
vendor/
*.exe
dist/
out/
release/
_verify/
playwright-report/
test-results/
e2e/.fixtures/
# Local only, and never sent to the web host: release secrets, session files, logs.
.env*
!.env.release.example
.claude/
*.log
scorecard.json
